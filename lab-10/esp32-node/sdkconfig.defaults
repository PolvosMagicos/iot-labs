# Rust's MQTT client and the P-256/AES-GCM publishing path share the main task.
# Their combined release-mode stack frame exceeds 32 KiB on the ESP32-S3.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_MQTT_TASK_STACK_SIZE=12288
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MINIMAL_SHARED_STACK_SIZE=4096
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
